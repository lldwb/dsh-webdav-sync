{
  "name": "dsh-webdav-sync",
  "version": "0.2.1",
  "description": "通过 WebDAV 在多设备间同步 DeepSeek Harness 的配置与插件（不同步会话）。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.png",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test/*",
    "package-lock.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "webdav",
    "sync",
    "backup",
    "jianguoyun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-webdav-sync.git"
  },
  "homepage": "https://github.com/lldwb/dsh-webdav-sync#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-webdav-sync/issues"
  },
  "meta": {
    "title": "WebDAV 云同步",
    "description": "通过 WebDAV 在多设备间同步 DeepSeek Harness 的配置与插件，不同步会话。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
